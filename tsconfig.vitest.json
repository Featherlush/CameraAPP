{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/vue.d.ts",
    "src/types/global.d.ts", // 测试代码也引入global.d.ts
    "src/**/__tests__/*",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "env.d.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "lib": [],
    "types": ["node", "jsdom"],
    // 测试环境也识别自定义类型
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  }
}
